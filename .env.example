# Detection model: yolo11n.pt (fastest) | yolo11s.pt (default) | yolo11m.pt (most accurate)
MODEL=yolo11s.pt
# Default confidence threshold (0.05-0.95). Detections below it are never shown.
CONF=0.40
# NMS IoU (0.30-0.90). Lower removes overlapping duplicates more aggressively.
IOU=0.50
# Inference size: auto (960 if this machine runs it within LATENCY_BUDGET_MS, else 640), or 320 / 416 / 640 / 960
IMGSZ=auto
LATENCY_BUDGET_MS=150
# Boxes thinner than this many pixels are discarded as noise
MIN_BOX_PX=12
# Frames wider than this are downscaled before inference (uploaded 4K video etc.)
MAX_FRAME_WIDTH=1280
MAX_UPLOAD_MB=200
# Device: auto (CUDA GPU if PyTorch can use one, else CPU) | cpu | cuda | cuda:N
DEVICE=auto
# FP16 inference on CUDA (set 0 if a GPU produces no detections)
HALF=1
JPEG_QUALITY=80
# Uploaded video: process every Nth frame (1 = all)
FRAME_STRIDE=1
# Tracker appearance model: mobilenet (steadier IDs) | none (motion only, faster on CPU)
TRACKER_EMBEDDER=mobilenet
TRACK_MAX_AGE=30
TRACK_N_INIT=3
TRACK_MAX_COSINE=0.30
# Delete uploaded videos older than this many hours
UPLOAD_TTL_HOURS=24
